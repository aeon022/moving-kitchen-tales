{
  "name": "moving-kitchen-tales",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "manifest": "node scripts/gen-plan-manifest.mjs",
    "predev": "npm run manifest",
    "dev": "vite",
    "prebuild": "npm run manifest",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check": "node --experimental-strip-types scripts/check-plans.mjs && node --experimental-strip-types scripts/test-fridge.mjs && node --experimental-strip-types scripts/test-rice.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "npm:rolldown-vite@7.1.12",
    "minimatch": "11.0.1"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.12",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "$minimatch"
    }
  }
}
